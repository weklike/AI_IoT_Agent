AGENT_TOOL_TIMEOUT_SECONDS=3
AGENT_TOTAL_TIMEOUT_SECONDS=90
AGENT_CLEANUP_TIMEOUT_SECONDS=5
AGENT_MAX_MODEL_REQUESTS=6
